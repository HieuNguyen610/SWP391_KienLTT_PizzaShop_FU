@startuml
' Change Password Sequence - PizzaShop
' Reflects POST /profile/change-password handled by ProfileController and UserServiceImpl

autonumber
skinparam sequenceArrowThickness 1
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "ProfileController" as C <<Controller>>
participant Model as M
participant "UserService" as S <<Service>>
participant "BCryptPasswordEncoder" as Enc
database "UserRepository" as Repo
entity "User" as U

== Submit change-password form ==
User -> C: POST /profile/change-password\n(oldPassword, newPassword, confirmPassword, currentUser)
activate C
C -> M: addAttribute("user", U)

alt confirmPassword != newPassword
  C -> M: addAttribute("pwdError",\n    "New password and confirmation do not match.")
  C --> User: return view "profile"
  deactivate C
else
  C -> S: changePassword(U, oldPassword, newPassword)
  activate S
  ' 1) Validate old password
  S -> Enc: matches(oldPassword, U.password)
  alt old password invalid
    Enc --> S: false
    S --> C: OLD_PASSWORD_INVALID
  else old password correct
    Enc --> S: true
    ' 2) Prevent same password
    S -> Enc: matches(newPassword, U.password)
    alt new password same as old
      Enc --> S: true
      S --> C: NEW_PASSWORD_SAME_AS_OLD
    else new password different
      Enc --> S: false
      ' 3) Strength check (min length 8)
      alt newPassword.length < 8
        S --> C: WEAK_NEW_PASSWORD
      else strong enough
        S -> Enc: encode(newPassword)
        Enc --> S: hashedPassword
        S -> U: setPassword(hashedPassword)
        S -> Repo: save(U)
        Repo --> S: persisted
        S --> C: SUCCESS
      end
    end
  end
  deactivate S

  ' Controller maps result to message and returns view
  alt result == SUCCESS
    C -> M: addAttribute("pwdSuccess",\n      "Password changed successfully.")
  else OLD_PASSWORD_INVALID
    C -> M: addAttribute("pwdError",\n      "Old password is incorrect.")
  else NEW_PASSWORD_SAME_AS_OLD
    C -> M: addAttribute("pwdError",\n      "New password must be different from the old password.")
  else WEAK_NEW_PASSWORD
    C -> M: addAttribute("pwdError",\n      "New password is too weak (minimum 8 characters).")
  else ERROR
    C -> M: addAttribute("pwdError",\n      "Unable to change password. Please try again.")
  end
  C --> User: return view "profile"
  deactivate C
end

@enduml