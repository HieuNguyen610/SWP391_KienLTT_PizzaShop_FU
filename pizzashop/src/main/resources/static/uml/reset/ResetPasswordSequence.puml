@startuml
' Sequence 1: Request password reset (user submits email)
autonumber
actor User
participant "PasswordResetController" as PRC
participant "UserService" as US
participant "UserRepository" as UR
participant "PasswordResetTokenRepository" as TR
participant "EmailService" as ES

User -> PRC: GET /forgot-password
PRC --> User: 200 forgot-password page

User -> PRC: POST /forgot-password (email)
PRC -> US: initiatePasswordReset(email)
US -> UR: findByEmail(email)
UR --> US: User / null
alt user exists
  US -> TR: deleteByUserId(user.id)
  US -> TR: existsByToken(generatedToken)
  TR --> US: false
  US -> TR: save(new PasswordResetToken)
  US --> PRC: Optional[token]
  PRC -> ES: sendPasswordResetEmail(user, link)
  ES --> PRC: (queued)
  PRC --> User: 200 forgot-password (success msg)
else user missing
  US --> PRC: Optional.empty
  PRC --> User: 200 forgot-password (error msg)
end
@enduml

@startuml
' Sequence 2: Reset password using token (happy path)
autonumber
actor User
participant "PasswordResetController" as PRC
participant "UserService" as US
participant "PasswordResetTokenRepository" as TR
participant "UserRepository" as UR

User -> PRC: GET /reset-password?token=XYZ
PRC -> US: findByResetPasswordToken(token)
US -> TR: findByToken(token)
TR --> US: PasswordResetToken (valid)
US --> PRC: Optional<User>
PRC --> User: 200 reset-password form

User -> PRC: POST /reset-password (token,newPw,confirmPw)
PRC -> US: resetPassword(token,newPw)
US -> TR: findByToken(token)
TR --> US: PasswordResetToken
US -> UR: save(user with encoded password)
US -> TR: save(token.used=true)
US --> PRC: true
PRC --> User: 302 Redirect /login?reset
@enduml
