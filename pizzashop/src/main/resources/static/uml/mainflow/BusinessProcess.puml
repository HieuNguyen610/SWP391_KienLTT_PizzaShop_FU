@startuml
' Simplified high-level swimlane for Pizza Shop online order
' Focus on major phases and actors only

skinparam linetype ortho

title Pizza Shop Order Process

|Customer|
start
:Browse & select items;
:Add to cart;
:Checkout ;
:Select payment method;

|Website|
:Create order (PENDING);
:Process payment;
:Mark order PAID;


|Staff|
:Cook order (status COOKING);
:Deliver order (status DELIVERING);

|Customer|
:Receive order ;

|Staff|
:Mark COMPLETED;

|Website|
:Show order history ;
stop

@enduml
