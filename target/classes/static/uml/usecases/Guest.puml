@startuml
' Guest Use Case Diagram - PizzaShop
left to right direction
skinparam usecaseBorderColor #555555
skinparam usecaseBackgroundColor #F9F9F9
skinparam packageStyle rectangle
skinparam shadowing false

actor Guest as G

rectangle "PizzaShop Web Application" as System {
  usecase UC1 as "View Home Page"
  usecase UC2 as "Browse Categories"
  usecase UC3 as "View Foods in Category"
  usecase UC4 as "View Food Details"
  usecase UC5 as "Search Foods"
  usecase UC6 as "View Promotions / Discounts"
  usecase UC7 as "Register Account"
  usecase UC8 as "Login"
  usecase UC9 as "Request Password Reset\n(Forgot Password)"
  usecase UC10 as "Add Item to Cart"
}

G --> UC1
G --> UC2
G --> UC3
G --> UC4
G --> UC5
G --> UC6
G --> UC7
G --> UC8
G --> UC9
G --> UC10

' Structural relationships among browsing actions
UC3 .> UC2 : <<include>>
UC4 .> UC3 : <<include>>
UC5 .> UC2 : <<extend>>
UC7 .> UC1 : <<precondition>>
UC8 .> UC1 : <<precondition>>
UC9 .> UC8 : <<extend>>


@enduml